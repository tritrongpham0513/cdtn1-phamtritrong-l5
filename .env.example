# =============================================================================
# Mekong Mobile Smart CRM - Module L5 (Spare-part Inventory)
# Environment template for Docker Compose
#
# Usage:
#   cp .env.example .env
#   docker compose up -d --build --wait
#
# Docker Compose reads .env automatically. Every value below has a safe
# default in docker-compose.yml, so the stack also starts without a .env file.
# For a local Maven run, export the required variables in your shell instead.
# =============================================================================

# --- Published host ports ----------------------------------------------------
# Web UI / REST API on the host (container listens on 8080)
APP_PORT=8088
# MySQL on the host (container listens on 3306; 3307 avoids local conflicts)
MYSQL_HOST_PORT=3307

# --- MySQL 8.0 container -----------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mekong_crm_inventory
MYSQL_USER=springstudent
MYSQL_PASSWORD=springstudent

# --- Spring Boot application -------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SEED_ENABLED=true
SEED_DATA_PATH=seeds

# --- Runtime timezone --------------------------------------------------------
TZ=Asia/Ho_Chi_Minh
